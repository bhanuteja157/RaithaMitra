# RaithaMitra Root Environment Configuration Template
ENVIRONMENT=development
API_V1_STR=/api/v1
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Supabase PostgreSQL Integration (Optional in prototype mode; uses local adapter if empty)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=
SUPABASE_DB_PASSWORD=

# Live Agricultural Biotechnology, Genomics, Google Maps & Gemini Integrations (AD-05)
EUROPE_PMC_BASE_URL=https://www.ebi.ac.uk/europepmc/webservices/rest/search
NCBI_API_KEY=
NCBI_EMAIL=
GOOGLE_PLACES_API_KEY=
GOOGLE_ROUTES_API_KEY=
GEMINI_API_KEY=

# Mobile OTP SMS Verification Provider (Twilio Verify - AD-14)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
OTP_PEPPER=replace-with-random-secret-pepper

# Local Demo Mobile OTP (AD-19B - strictly for local development and explicitly configured demo accounts)
DEMO_OTP_ENABLED=false
# Format: user_id:+91XXXXXXXXXX:6digit_otp (comma-separated placeholders)
DEMO_OTP_MAP=usr_farmer:+910000000001:000001,usr_buyer1:+910000000002:000002,usr_buyer2:+910000000003:000003,usr_labour:+910000000004:000004,usr_driver:+910000000005:000005

